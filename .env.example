# Spring profile (local | uat | prod)
SPRING_PROFILES_ACTIVE=uat

# Database
DB_URL=jdbc:postgresql://postgres:5432/profitsaathi
DB_USERNAME=myuser
DB_PASSWORD=replace-me

# Redis (format: redis://[password@]host:port[/database])
SPRING_REDIS_URL=redis://redis:6379

# CORS — comma-separated origins
ALLOWED_ORIGINS=https://app.example.com

# JWT — must be >= 32 random bytes
JWT_SECRET=please-generate-a-real-secret-of-at-least-32-bytes
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14
JWT_ISSUER=profitsaathi

# AES — 32-byte key, used for encrypted request bodies and field-level encryption
AES_SECRET_KEY=12345678901234567890123456789012

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# WAHA (WhatsApp HTTP API)
WAHA_URL=http://waha:3000
WAHA_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI providers (optional)
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=ProfitSaathi

# Public base URL (used for links in emails / WhatsApp)
PUBLIC_API_URL=https://app.example.com

# Logging — json (containerised) or plain (local dev)
LOG_FORMAT=json
